# Copy to .env and fill in. NEVER commit .env.

# LLM: Google AI Studio (Gemini) free-tier API key.
GEMINI_API_KEY=

# Optional: Hugging Face token for pyannote diarization (Phase 5 fallback).
HF_TOKEN=

# Optional: Gmail app password for email delivery.
SMTP_APP_PASSWORD=

# Optional: Groq free-tier API key for the Groq Whisper transcriber provider.
GROQ_API_KEY=

# Optional: bearer token required when the web UI is exposed beyond localhost.
MEETINGBOT_WEB_TOKEN=

# Optional: S3-compatible storage (Cloudflare R2, Backblaze B2, MinIO, AWS S3).
# Set delivery.s3.enabled: true in config.yaml. Names are configurable there.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
